{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  // The fourth program: the tests that import `src/desktop/renderer/dom/`.
  //
  // They cannot live in the base program — its `lib` is `ES2022` only, and that
  // absence is the *only* thing stopping host and TUI code from touching
  // `document`. Adding "DOM" there to save a config would give that up
  // everywhere. So these files are excluded from the base config and checked
  // here instead; `test/rendererImports.test.ts` asserts the two lists agree.
  //
  // `module`/`moduleResolution` stay NodeNext by inheritance: these are `node:test`
  // files, and the renderer specifiers they import already carry `.js`.
  // `src/types/picomatch.d.ts` for the same reason `tsconfig.renderer.json` lists
  // it: TypeScript follows imports past `include`, so the transcript types drag
  // `harness/` in, and the ambient declaration has to come with them.
  "include": [
    "test/rendererBoot.test.ts",
    "test/rendererBrowserPanelView.test.ts",
    "test/rendererCanvasHeaderView.test.ts",
    "test/rendererCommandsPanelView.test.ts",
    "test/rendererSubagentPanelView.test.ts",
    "test/rendererComposerView.test.ts",
    "test/rendererDismiss.test.ts",
    "test/rendererMarkdownView.test.ts",
    "test/rendererOverlayView.test.ts",
    "test/rendererPaneDispose.test.ts",
    "test/rendererPresenceView.test.ts",
    "test/rendererSettingsView.test.ts",
    "test/rendererSidebarView.test.ts",
    "test/rendererStatusView.test.ts",
    "test/rendererTaskPanelView.test.ts",
    "test/rendererToastView.test.ts",
    "test/rendererFailureFeedback.test.ts",
    "test/rendererMergeBarView.test.ts",
    "test/rendererThreadPanelView.test.ts",
    "test/rendererThreadDetailView.test.ts",
    "test/rendererTitleBarView.test.ts",
    "test/rendererTranscriptView.test.ts",
    "test/rendererWelcomeView.test.ts",
    "test/rendererWorkingMark.test.ts",
    "test/helpers/**/*.ts",
    "src/types/picomatch.d.ts"
  ],
  // Restated for the same reason `tsconfig.preload.json` restates it: the base
  // `exclude` names exactly the files this program exists to check, and
  // inheriting it would leave an empty program reporting a false green.
  "exclude": ["node_modules", "dist"]
}
